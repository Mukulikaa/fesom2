! This is the namelist file for forcing

&forcing_exchange_coeff
Ce_atm_oce=0.00175 ! exchange coeff. of latent heat over open water
Ch_atm_oce=0.00175 ! exchange coeff. of sensible heat over open water
Cd_atm_oce=0.001   ! drag coefficient between atmosphere and water
Ce_atm_ice=0.00175 ! exchange coeff. of latent heat over ice
Ch_atm_ice=0.00175 ! exchange coeff. of sensible heat over ice
Cd_atm_ice=0.0012  ! drag coefficient between atmosphere and ice 
Swind     =0.0     ! parameterization for coupled current feedback
/

&forcing_bulk
AOMIP_drag_coeff=.false.
ncar_bulk_formulae=.true.
ncar_bulk_z_wind=10.0 ! height at which wind forcing is located (CORE, JRA-do: 10m; NCEP/ERA5: 10m)
ncar_bulk_z_tair=2.0  ! height at which temp forcing is located (CORE, JRA-do: 10m; NCEP/ERA5: 2m)
ncar_bulk_z_shum=2.0  ! height at which humi forcing is located (CORE, JRA-do: 10m; NCEP/ERA5: 2m)
/

&land_ice
use_landice_water=.false.
landice_start_mon=5
landice_end_mon=10
fwf_path='./mesh/'
/

&age_tracer
use_age_tracer=.false.
use_age_mask=.false.
age_tracer_path='./mesh/'
age_start_year=2000
/

&nam_sbc
nm_xwind_file = '/albedo/work/projects/p_pool_fesom1/forcing/ERA5/3H/u10.era5.'  ! name of file with winds, if nm_sbc=2
nm_ywind_file = '/albedo/work/projects/p_pool_fesom1/forcing/ERA5/3H/v10.era5.'  ! name of file with winds, if nm_sbc=2
nm_humi_file  = '/albedo/work/projects/p_pool_fesom1/forcing/ERA5/3H/q2m.era5.'  ! name of file with 2m specific humidity
nm_qsr_file   = '/albedo/work/projects/p_pool_fesom1/forcing/ERA5/3H/ssrd.era5.' ! name of file with solar heat
nm_qlw_file   = '/albedo/work/projects/p_pool_fesom1/forcing/ERA5/3H/strd.era5.' ! name of file with Long wave
nm_tair_file  = '/albedo/work/projects/p_pool_fesom1/forcing/ERA5/3H/t2m.era5.'  ! name of file with 2m air temperature
nm_prec_file  = '/albedo/work/projects/p_pool_fesom1/forcing/ERA5/3H/rf.era5.'   ! name of file with total precipitation/rain fall
                                                                                 ! - rain fall is mandatory if 'l_snow=.true.'!!!
nm_snow_file  = '/albedo/work/projects/p_pool_fesom1/forcing/ERA5/3H/sf.era5.'   ! name of file with snow fall
nm_mslp_file  = '/albedo/work/projects/p_pool_fesom1/forcing/ERA5/3H/msl.era5.'  ! name of file with air_pressure_at_sea_level
nm_xwind_var  = 'u10'   ! name of variable in file with wind
nm_ywind_var  = 'v10'   ! name of variable in file with wind
nm_humi_var   = 'q2m'   ! name of variable in file with humidity
nm_qsr_var    = 'ssrd'  ! name of variable in file with solar heat
nm_qlw_var    = 'strd'  ! name of variable in file with Long wave
nm_tair_var   = 't2m'   ! name of variable in file with 2m air temperature
nm_prec_var   = 'rf'    ! name of variable in file with total precipitation
nm_snow_var   = 'sf'    ! name of variable in file with total precipitation
nm_mslp_var   = 'sp'    ! name of variable in file with air_pressure_at_sea_level
nm_nc_iyear   = 1900    ! initial year of time axis in netCDF
nm_nc_imm     = 1       ! initial month of time axis in netCDF
nm_nc_idd     = 1       ! initial day of time axis in netCDF
nm_nc_freq    = 24      ! time axis unit (24 if the time axis is in hours; 86400 if the time axis is in seconds)
nm_nc_tmid    = 0       ! 1 if the time stamps are given at the mid points of the netcdf file, 0 otherwise (i.e. 1 in CORE1/CORE2; 0 in JRA-do/ERA5)
l_xwind=.true., l_ywind=.true., l_humi=.true., l_qsr=.true., l_qlw=.true., l_tair=.true., l_prec=.true., l_mslp=.false., l_cloud=.false., l_snow=.true.
nm_runoff_file     ='/albedo/work/projects/p_pool_fesom1/forcing/JRA55-do-v1.4.0/CORE2_runoff.nc'
runoff_data_source ='CORE2' !Dai09, CORE2, JRA55
runoff_climatology =.true.
nm_sss_data_file   ='/albedo/work/projects/p_pool_fesom1/forcing/JRA55-do-v1.4.0/PHC2_salx.nc'
sss_data_source    ='CORE2'
chl_data_source    ='None' ! 'Sweeney' monthly chlorophyll climatology or 'NONE' for constant chl_const (below).
                           ! Make use_sw_pene=.TRUE. in namelist.config!
nm_chl_data_file   ='/albedo/work/projects/p_fesom/FROM-OLLIE/forcing/Sweeney/Sweeney_2005.nc'
use_runoff_mapper  = .FALSE.
runoff_basins_file = 'runoff_maps_regular.nc'
runoff_radius      = 500000.
\
